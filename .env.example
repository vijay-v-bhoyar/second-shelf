SECOND_SHELF_PROVIDER_MODE=fixture
SECOND_SHELF_DATA_DIR=.data/second-shelf
# Neon pooled PostgreSQL URL, required on Vercel. Leave blank for local PGlite.
DATABASE_URL=
# Required on Vercel; generated privately during deployment, never committed.
SECOND_SHELF_BOOTSTRAP_SECRET=
SECOND_SHELF_DEMO_STORES_PER_DAY=100
SECOND_SHELF_LIVE_CALLS_AUTHORIZED=false
# Installation-wide attempted-call allowance, persisted per UTC day in its database.
# This does not establish Qloo's actual account quota or a monetary cap.
SECOND_SHELF_QLOO_DAILY_CALL_LIMIT=100
# Leave blank locally. Set the exact origin only for an authorized accessible host.
SECOND_SHELF_APP_ORIGIN=
# Configure locally only after authorizing the account. Never commit a key.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
